---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection, render } from "astro:content";
import { buildSchemaGraph } from "../../lib/schema/graph";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/blog/${entry.id}/`;
const title = entry.data.title;
const description = entry.data.description;
const dateISO = entry.data.pubDate.toISOString().slice(0, 10);
const dateHuman = entry.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const crumbs = [
  { name: "Blog", path: "/blog/" },
  { name: title, path },
];
const schema = buildSchemaGraph({
  pageType: "article",
  path,
  title,
  description,
  breadcrumbs: crumbs,
  article: { headline: title, datePublished: dateISO },
});
---
<BaseLayout {title} {description} {path} {schema}>
  <PageHero title={title} crumbs={crumbs}>
    <p class="lede" style="margin-bottom: 0;">
      <time datetime={dateISO}>{dateHuman}</time> · Warrior Removals team
    </p>
  </PageHero>
  <section class="section">
    <article class="container prose">
      <Content />
    </article>
  </section>
  <CtaBand />
</BaseLayout>
