---
interface Crumb { name: string; path: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((item) => (
      <li><a href={item.path}>{item.name}</a></li>
    ))}
  </ol>
</nav>
